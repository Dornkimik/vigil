# Vigil default heuristic rules
#
# Format:
#   rule <id>
#     desc   <human readable description>
#     weight <points added to the file's score when the rule fires>
#     min    <how many distinct `str` patterns must be present>
#     require <pattern> | <alternative>  (each require line must have a hit)
#     scope  any | pe | script | shortcut   (default: any)
#     case   exact                          (optional: case-sensitive matching)
#     near   <bytes>     (optional: everything above must be met within one window
#                         of this many bytes, not just anywhere in a big file)
#     mask   <pattern>   (optional: hits inside an occurrence of this don't count)
#     str    <pattern>   (case-insensitive; also matched as UTF-16 and with
#                         doubled backslashes, so .NET and script sources hit too)
#   end
#
# Score thresholds: >= 35 suspicious, >= 70 malicious. A valid Authenticode
# signature removes 60% of the heuristic score. Keep weights conservative: these rules
# run on every Steam game DLL, so single generic strings must never convict.
#
# Users can add their own rules in %LOCALAPPDATA%\Vigil\custom.rules.

# ---------------------------------------------------------------- info stealers

rule stealer.browser_profiles
  desc   Enumerates profile folders of several different browsers
  weight 5
  min    3
  str    \Google\Chrome\User Data
  str    \BraveSoftware\Brave-Browser
  str    \Microsoft\Edge\User Data
  str    \Opera Software\Opera
  str    \Yandex\YandexBrowser
  str    \Vivaldi\User Data
  str    \Mozilla\Firefox\Profiles
  str    \Chromium\User Data
end

# Chromium-embedding binaries (libcef.dll etc.) legitimately contain some of
# these, so this rule alone stays below the suspicious threshold.
rule stealer.browser_credentials
  desc   Reads browser password, cookie or autofill databases
  weight 20
  min    3
  require \Login Data | logins.json | cookies.sqlite
  require encrypted_key | CryptUnprotectData | key4.db
  str    \Login Data
  str    \Local State
  str    encrypted_key
  str    \Web Data
  str    logins.json
  str    key4.db
  str    cookies.sqlite
  str    CryptUnprotectData
end

rule stealer.discord_tokens
  desc   Hunts for Discord login tokens
  weight 25
  min    2
  require dQw4w9WgXcQ: | discord.com/api/v9/users/@me
  require \discord\Local Storage\leveldb | \Local Storage\leveldb
  str    dQw4w9WgXcQ:
  str    \discord\Local Storage\leveldb
  str    discordcanary
  str    discordptb
  str    \Local Storage\leveldb
  str    discord.com/api/v9/users/@me
end

rule stealer.crypto_wallets
  desc   Searches for cryptocurrency wallets and wallet extensions
  weight 20
  min    2
  str    wallet.dat
  str    \Exodus\exodus.wallet
  str    \Electrum\wallets
  str    \atomic\Local Storage
  str    \Ethereum\keystore
  str    \Coinomi\Coinomi\wallets
  str    nkbihfbeogaeaoehlefnkodbefgpgknn
  str    bfnaelmomeimhlpmgjnjophhpkkoljpa
  str    hnfanknocfeofbddgcijnmhnfnkdnaad
  str    fhbohimaelbohpjbbldcngcnapndodjp
  str    ibnejdfjmmkpcnlpebklmnkoeoihofec
end

rule stealer.telegram_session
  desc   Copies Telegram Desktop session data
  weight 20
  min    1
  str    \Telegram Desktop\tdata
  str    D877F783D5D3EF8C
end

rule stealer.steam_session
  desc   Reads Steam login/session files
  weight 20
  min    2
  str    loginusers.vdf
  str    \Steam\config\
  str    config\config.vdf
  str    Steam\ssfn
end

rule stealer.exfil_channel
  desc   Contains a Discord webhook or Telegram bot endpoint (common exfiltration channels)
  weight 20
  min    1
  str    discord.com/api/webhooks/
  str    discordapp.com/api/webhooks/
  str    api.telegram.org/bot
end

rule stealer.recon
  desc   Looks up the machine's public IP / geolocation
  weight 0
  min    1
  str    ip-api.com/json
  str    ipinfo.io/json
  str    api.ipify.org
  str    icanhazip.com
  str    checkip.amazonaws.com
  str    geolocation-db.com
end

rule stealer.family_names
  desc   Contains names of well-known info-stealer families
  weight 0
  min    1
  case   exact
  str    LummaC2
  str    RedLine Stealer
  str    Vidar Stealer
  str    Raccoon Stealer
  str    Epsilon Stealer
  str    BlankGrabber
  str    Luna Grabber
end

# ---------------------------------------------------------------- loaders / droppers

# Editors, terminals and browsers ship lists of PowerShell command names (allow/deny
# lists, syntax tables, Chrome's paste-and-run checks); a list entry is data, not a download.
rule loader.download_cradle
  desc   Downloads and executes code (PowerShell / LOLBin download cradle)
  weight 35
  min    2
  require DownloadString | DownloadData | Invoke-WebRequest
  require Invoke-Expression | IEX( | IEX ( | IEX $ | 'IEX' | "IEX" | | IEX | ScriptBlock]::Create
  mask   "Invoke-WebRequest",
  mask   "Invoke-WebRequest"]
  mask   "Invoke-WebRequest":
  mask   'Invoke-WebRequest',
  mask   'Invoke-WebRequest']
  mask   'Invoke-WebRequest':
  mask   ,Invoke-WebRequest,
  str    DownloadString(
  str    DownloadFile(
  str    DownloadData(
  str    New-Object Net.WebClient
  str    New-Object System.Net.WebClient
  str    Invoke-Expression
  str    IEX(
  str    IEX (
  str    -EncodedCommand
  str    [Convert]::FromBase64String
  str    -WindowStyle Hidden
  str    -w hidden
  str    Invoke-WebRequest
  str    bitsadmin /transfer
  str    certutil -urlcache
  str    certutil.exe -urlcache
  str    certutil -decode
  str    mshta http
  str    Start-BitsTransfer
end

# curl | iex. Bundles and docs for local HTTP APIs are full of "curl http://localhost",
# so curl only counts right next to the execution.
rule loader.curl_cradle
  desc   Downloads code with curl and runs it with PowerShell
  weight 35
  near   256
  require curl http | curl.exe http
  require Invoke-Expression | IEX( | IEX ( | IEX $ | | IEX | ScriptBlock]::Create
end

# exec(requests.get(url).text) and friends. These names are everywhere in large
# JS bundles (RegExp .exec(), a Map called requests) and Python's own test suite,
# so they only count when they sit together.
rule loader.script_cradle
  desc   Downloads code and runs it with exec/eval
  weight 35
  scope  script
  near   256
  require requests.get( | urlopen(
  require exec( | eval(
end

rule loader.script_dropper
  desc   Windows Script Host dropper pattern (shell + HTTP + file write)
  weight 35
  min    3
  scope  script
  require MSXML2.XMLHTTP | MSXML2.ServerXMLHTTP | WinHttp.WinHttpRequest
  require ADODB.Stream | Scripting.FileSystemObject
  require .Run( | .Run ( | .Run " | .Exec( | ShellExecute
  str    WScript.Shell
  str    ActiveXObject
  str    Scripting.FileSystemObject
  str    MSXML2.XMLHTTP
  str    MSXML2.ServerXMLHTTP
  str    WinHttp.WinHttpRequest
  str    ADODB.Stream
  str    Shell.Application
  str    WScript.CreateObject
end

rule loader.paste_hosts
  desc   References paste/anonymous file hosts often used to stage payloads
  weight 0
  min    1
  str    pastebin.com/raw
  str    paste.ee/r/
  str    rentry.co/
  str    transfer.sh/
  str    gofile.io/d
  str    files.catbox.moe
end

rule loader.autoit
  desc   Compiled AutoIt script (heavily abused by malware loaders)
  weight 0
  min    1
  scope  pe
  str    AU3!EA06
end

rule loader.pyinstaller
  desc   PyInstaller-packed Python program (common for stealers, also legit tools)
  weight 0
  min    2
  scope  pe
  str    _MEIPASS
  str    pyi-runtime-tmpdir
  str    PyInstaller
end

# ---------------------------------------------------------------- defense evasion

rule evasion.defender_tamper
  desc   Tries to disable or add exclusions to Microsoft Defender
  weight 25
  min    1
  require Add-MpPreference | Set-MpPreference
  require -ExclusionPath | -ExclusionProcess | -ExclusionExtension | -DisableRealtimeMonitoring $true | -DisableRealtimeMonitoring 1
end

rule evasion.uac_bypass
  desc   Known UAC bypass via auto-elevating Windows binaries
  weight 35
  min    1
  require DelegateExecute | fodhelper.exe | eventvwr.exe | computerdefaults.exe
  require ms-settings\Shell\Open\command | mscfile\shell\open\command
  str    ms-settings\Shell\Open\command
  str    mscfile\shell\open\command
end

rule evasion.anti_analysis
  desc   Checks for virtual machines, sandboxes or analysis tools
  weight 10
  min    4
  str    VBoxService
  str    VBoxTray
  str    vmtoolsd
  str    vmwaretray
  str    SbieDll.dll
  str    wireshark
  str    x64dbg
  str    ollydbg
  str    ProcessHacker
  str    HTTPDebuggerUI
  str    fiddler
  str    dnSpy
  str    cuckoo
  str    VMware Virtual Platform
  str    qemu-ga
end

# GetProcessesByName covers .NET AV killers, which call Process.Kill() instead of
# taskkill. .NET passes process names without ".exe", so names here omit it.
rule evasion.kill_security_tools
  desc   Terminates security software processes
  weight 25
  min    2
  require taskkill /f /im | taskkill.exe /f /im | Stop-Process | GetProcessesByName
  require MsMpEng | avp.exe | MBAMService | bdagent | ekrn.exe | MsSense | SentinelAgent | CSFalconService
  str    MsMpEng
  str    taskkill /f /im
  str    avp.exe
  str    MBAMService
  str    bdagent
  str    ekrn.exe
  str    MsSense
  str    SentinelAgent
  str    CSFalconService
end

# A Debugger value under IFEO runs another program instead of the named one.
# Process Explorer does this for taskmgr.exe, so only security tools count here.
rule evasion.ifeo_hijack
  desc   Uses Image File Execution Options to stop security software from starting
  weight 35
  require Image File Execution Options
  require Debugger
  require MsMpEng.exe | MpCmdRun.exe | MsSense.exe | SecurityHealthSystray.exe | SentinelAgent.exe | CSFalconService.exe | ekrn.exe | egui.exe | avp.exe | avpui.exe | bdagent.exe | MBAMService.exe | mbam.exe
end

# ---------------------------------------------------------------- impact

rule impact.ransomware
  desc   Contains a command to delete backups or disable recovery
  weight 20
  min    1
  str    vssadmin delete shadows
  str    vssadmin.exe delete shadows
  str    wmic shadowcopy delete
  str    wbadmin delete catalog
  str    recoveryenabled no
end

rule impact.ransom_note
  desc   Contains ransom-demand wording
  weight 20
  require your files have been encrypted | all your files are encrypted
  require bitcoin | monero | decrypt | ransom
end

rule impact.cryptominer
  desc   Embedded cryptocurrency miner
  weight 15
  min    1
  require stratum+tcp:// | stratum+ssl://
  require --donate-level | xmrig | cryptonight | randomx
  str    stratum+tcp://
  str    stratum+ssl://
  str    --donate-level
  str    xmrig
  str    cryptonight
end

rule impact.remote_access
  desc   Contains names of well-known remote-access trojans
  weight 0
  min    1
  case   exact
  str    AsyncRAT
  str    njRAT
  str    Quasar.Client
  str    DcRat
  str    Remcos
  str    XWorm
  str    CrySome
end

# Hidden VNC: a second desktop the user can't see, with programs started on it and
# captured. Desktop switchers create desktops too, but don't capture windows on them.
rule impact.hidden_desktop
  desc   Runs programs on a hidden desktop and captures its windows (hidden VNC)
  weight 20
  require CreateDesktop
  require SetThreadDesktop | lpDesktop
  require PrintWindow | BitBlt
end

# Electron apps, CEF and Chrome contain a whole browser, whose sandbox, screen capture
# and input handling match the API-shape rules above. The engine only treats this as
# a browser engine in binaries far larger than malware (see engine::BROWSER_ENGINE_SIZE).
rule info.chromium_engine
  desc   Contains the Chromium browser engine (Electron, CEF or Chrome)
  weight 0
  min    3
  scope  pe
  case   exact
  str    Chrome_WidgetWin_
  str    v8_context_snapshot
  str    chrome-extension://
  str    chrome://gpu
end

# Capability combinations, rather than individual API/tool names.
rule loader.memory_payload
  desc   Decodes a payload and loads it as an in-memory assembly
  weight 35
  scope  script
  require FromBase64String | DownloadData( | DownloadString(
  require [Reflection.Assembly]::Load( | [System.Reflection.Assembly]::Load(
  require .EntryPoint.Invoke( | .GetMethod(
end

rule evasion.amsi_tamper
  desc   Accesses AMSI internals to disable script scanning
  weight 35
  scope  script
  require AmsiUtils | AmsiScanBuffer
  require amsiInitFailed | VirtualProtect
  require SetValue( | Marshal]::Copy | Marshal.Copy
end

rule stealer.credential_dump
  desc   Contains credential-dumping command combinations
  weight 40
  require sekurlsa::logonpasswords | sekurlsa::ekeys | lsadump::sam | lsadump::dcsync
  require privilege::debug | token::elevate | /system: | /user:
end

rule stealer.keylogger
  desc   Captures keystrokes together with foreground-window context
  weight 25
  scope  script
  require GetAsyncKeyState | SetWindowsHookEx | pynput.keyboard.Listener
  require GetForegroundWindow | GetWindowText
  require WriteAllText | AppendAllText | WriteFile | sendmail( | UploadString(
end

# Overlays, macro tools and Chromium-embedding launchers install keyboard hooks too,
# so this mostly serves as corroboration.
rule stealer.keylogger_hook
  desc   Installs a keyboard hook and records the foreground window
  weight 5
  scope  pe
  require SetWindowsHookEx
  require CallNextHookEx
  require GetForegroundWindow
  require GetWindowText
end

rule impact.reverse_shell
  desc   Script combines a TCP command channel, command execution and a response stream
  weight 55
  scope  script
  require Net.Sockets.TCPClient
  require GetStream(
  require Invoke-Expression | IEX( | IEX $
  require .Write(
end

# Sockets and subprocesses meet all over Python test suites and tooling, so the
# Python form only counts as one compact block.
rule impact.python_reverse_shell
  desc   Script connects a TCP socket to a command shell
  weight 55
  scope  script
  near   1024
  require socket.socket(
  require .recv(
  require subprocess.Popen( | os.popen(
  require .send( | .sendall(
end

rule impact.miner_evasion
  desc   Mining endpoint combined with Defender exclusion changes
  weight 35
  scope  script
  require stratum+tcp:// | stratum+ssl://
  require Add-MpPreference | Set-MpPreference
  require -ExclusionPath | -ExclusionProcess
end

# ---------------------------------------------------------------- persistence (weak alone)

rule persistence.autorun
  desc   Installs itself to start automatically
  weight 10
  min    1
  str    \CurrentVersion\Run
  str    schtasks /create
  str    schtasks.exe /create
  str    \Start Menu\Programs\Startup
  str    Register-ScheduledTask
end

rule persistence.hidden_copy
  desc   Copies itself into a hidden/system-looking location
  weight 15
  min    2
  str    attrib +h +s
  str    attrib +s +h
  str    \AppData\Roaming\Microsoft\Windows\svchost.exe
  str    \AppData\Local\Temp\svchost.exe
  str    Copy-Item $PSCommandPath
end

# Push-button reset runs scripts listed in C:\Recovery\OEM\ResetConfig.xml, so a
# program registered there comes back after "Reset this PC".
rule persistence.recovery_partition
  desc   Registers itself to run again after Windows is reset
  weight 25
  require \Recovery\OEM | ResetConfig.xml
  require BasicReset_AfterImageApply | FactoryReset_AfterImageApply | FactoryReset_AfterDiskFormat
end

# ---------------------------------------------------------------- shortcuts

rule shortcut.launches_interpreter
  desc   Shortcut launches a script interpreter (classic LNK dropper)
  weight 10
  min    1
  scope  shortcut
  str    powershell
  str    pwsh
  str    cmd.exe
  str    mshta
  str    wscript
  str    cscript
  str    rundll32
  str    regsvr32
  str    conhost
  str    certutil
  str    bitsadmin
  str    curl
end
